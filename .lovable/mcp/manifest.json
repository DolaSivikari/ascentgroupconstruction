        "name": "list_projects",
        "title": "List projects",
        "description": "List Ascent Group construction projects with their status, location, category and publish state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional text to match against the project title or location.",
              "type": [
                "string",
                "null"
              ]
            },
            "featured_only": {
              "description": "When true, return only projects flagged as featured.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of projects to return (default 20, max 100)."
            }
          },
          "required": [
            "search",
            "featured_only",
            "limit"
          ]
        },
        "outputSchema": null
      },
